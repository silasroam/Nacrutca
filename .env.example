# Telegram
# Get token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Comma separated list of telegram numeric user IDs allowed to use admin commands
ADMIN_IDS=123456789,987654321

# ---- Support Bot (a separate bot, see support_bot/) ----
# Token for the dedicated Support Bot (create it separately via @BotFather).
SUPPORT_BOT_TOKEN=your_support_bot_token_here
# Numeric Telegram ID of the single support operator/admin (NOT a username).
ADMIN_TELEGRAM_ID=123456789
# Public username of the Support Bot (no @). Used by the main Traffic Bot to
# build the "Поддержка" button / deep links (t.me/<username>?start=ticket_<id>).
# Leave empty to hide the button entirely.
SUPPORT_BOT_USERNAME=

# Webhook vs polling. When using webhook set WEBHOOK_URL to the public HTTPS url.
USE_WEBHOOK=false
WEBHOOK_URL=https://your-domain.com/webhook
WEBHOOK_PATH=/webhook
WEB_PORT=8443

# Crypto payment provider (public key/address or API base).
# Keep secrets ONLY in environment variables, never in source code.
CRYPTO_API_KEY=
CRYPTO_WALLET_ADDRESS=

# Telegram Stars payment — enabled via StarsProvider when the bot has
# a Stars-connected store attached (see https://core.telegram.org/bots/payments).
STARS_PROVIDER_TOKEN=

# ---- Crypto payment (blockchain indexers) ----
# Secret API keys. Keep them ONLY in .env (never commit, never log them).
# TRONGRID_API_KEY=<from TronGrid dashboard>
# TONCENTER_API_KEY=<from toncenter.com>
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=<HELIUS_API_KEY>
#
# Litecoin uses Blockchair's public explorer link (no key required). The public
# Blockchair *API* for address-transactions is restricted, so the adapter falls
# back to this explorer URL for manual reconciliation:
LITECOIN_EXPLORER_URL=https://blockchair.com/litecoin/address

# Crypto invoice lifetime in seconds (default 30 minutes).
CRYPTO_INVOICE_TTL_SECONDS=1800

# ---- Database ----
# The storage layer ALWAYS uses an async engine (SQLAlchemy create_async_engine),
# so the URL must use an async driver.
#
# Local dev (SQLite file):
# DATABASE_URL=sqlite+aiosqlite:///./traffic_bot.db
#
# Production on Vercel/Neon (async Postgres via asyncpg). NOTE: use
# postgresql+asyncpg://... — a plain postgresql:// URL fails inside
# create_async_engine. asyncpg does NOT accept the `channel_binding=require`
# query param (that is psycopg-only), so strip it and use `?ssl=require`:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME?ssl=require